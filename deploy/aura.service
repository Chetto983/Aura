# Aura appliance compose unit.
#
# Install:
#   sudo install -d /opt/aura
#   sudo cp compose.yaml /opt/aura/
#   sudo cp -r caddy /opt/aura/
#   sudo cp deploy/aura.service /etc/systemd/system/aura.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aura.service
#   journalctl -u aura.service -f

[Unit]
Description=Aura appliance compose stack
Documentation=https://github.com/chetto1983/aura
After=network-online.target docker.service
Wants=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/aura
# The updater pulls; the unit starts what is on disk. Honouring pull_policy=always, a registry
# that refused a pull aborted the whole up and left no container running (lab VM, 2026-10-14).
ExecStart=/usr/bin/docker compose up -d --pull missing
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
# Stopping Docker stops this unit (Requires=), and its `compose down` removes every container, so
# Docker coming back -- a restart or an upgrade -- has to start the ordered `up` again (2026-10-14).
WantedBy=multi-user.target docker.service
