diff --git a/recognizers/italy_test.go b/recognizers/italy_test.go
new file mode 100644
index 0000000..118969d
--- /dev/null
+++ b/recognizers/italy_test.go
@@ -0,0 +1,166 @@
+package recognizers
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/hoophq/alcatraz/analyzer"
+	"github.com/hoophq/alcatraz/entities"
+)
+
+// Synthetic fixtures; no taxpayer records. The check characters follow Article 7
+// of the Italian Ministry of Finance decree dated 23 December 1976.
+const itFiscalExample = "RSSMRA80A01H501U"
+
+// Invert Article 7's odd-position correspondence instead of reusing the
+// production lookup table. A..J and 0..9 have the same conversion values.
+func fiscalTestCode(body string) string {
+	total := 0
+	for i, c := range body {
+		if c >= '0' && c <= '9' {
+			c = 'A' + c - '0'
+		}
+		if i%2 == 0 {
+			total += strings.IndexRune("BAKPLCQDREVOSFTGUHMINJWZYX", c)
+		} else {
+			total += int(c - 'A')
+		}
+	}
+	return body + string(rune('A'+total%26))
+}
+
+func TestITFiscalCode(t *testing.T) {
+	t.Parallel()
+	cases := []struct{ name, text, want string }{
+		{"valid checksum", itFiscalExample, itFiscalExample},
+		{"corrected upstream fixture", "RSSMRA85T10A562S", "RSSMRA85T10A562S"},
+		{"lowercase", "rssmra80a01h501u", "rssmra80a01h501u"},
+		{"mixed case", "RssMra80a01H501u", "RssMra80a01H501u"},
+		{"prose", "Codice fiscale: " + itFiscalExample + ".", itFiscalExample},
+		{"JSON", `{"cf":"` + itFiscalExample + `"}`, itFiscalExample},
+		{"UTF-8 prefix", "È il codice: " + itFiscalExample, itFiscalExample},
+		{"wrong upstream checksum", "RSSMRA85T10A562C", ""},
+		{"wrong checksum", "RSSMRA80A01H501V", ""},
+		{"short", itFiscalExample[:15], ""},
+		{"leading digit", "1" + itFiscalExample, ""},
+		{"trailing letter", itFiscalExample + "X", ""},
+		{"embedded ASCII token", "record_" + itFiscalExample, ""},
+		{"split lines", "RSSMRA80A01\nH501U", ""},
+		{"ordinary text", "The checksum must not hide ordinary words.", ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			got := ITFiscalCode().Analyze(tc.text, nil)
+			if tc.want == "" {
+				if len(got) != 0 {
+					t.Fatalf("unexpected findings: %+v", got)
+				}
+				return
+			}
+			if len(got) != 1 || got[0].EntityType != entities.ITFiscalCode ||
+				tc.text[got[0].Start:got[0].End] != tc.want || got[0].Score != analyzer.MaxScore {
+				t.Fatalf("expected exact span for %q, got %+v", tc.want, got)
+			}
+		})
+	}
+}
+
+func TestITFiscalCodeOmocodia(t *testing.T) {
+	t.Parallel()
+	// Article 6 replaces any subset of these seven digits with L M N P Q R S T U V.
+	positions := []int{6, 7, 9, 10, 12, 13, 14}
+	const replacements = "LMNPQRSTUV"
+	for mask := 0; mask < 1<<len(positions); mask++ {
+		t.Run(fmt.Sprintf("mask_%03d", mask), func(t *testing.T) {
+			body := []byte(itFiscalExample[:15])
+			for bit, pos := range positions {
+				if mask&(1<<bit) != 0 {
+					body[pos] = replacements[body[pos]-'0']
+				}
+			}
+			code := fiscalTestCode(string(body))
+			for _, input := range []string{code, strings.ToLower(code)} {
+				got := ITFiscalCode().Analyze(input, nil)
+				if len(got) != 1 || input[got[0].Start:got[0].End] != input {
+					t.Fatalf("omocodic form not detected: %q", input)
+				}
+			}
+			bad := code[:15] + string('A'+(code[15]-'A'+1)%26)
+			if got := ITFiscalCode().Analyze(bad, nil); len(got) != 0 {
+				t.Fatalf("wrong check character accepted: %q", bad)
+			}
+		})
+	}
+}
+
+func TestITFiscalCodeConversionTable(t *testing.T) {
+	t.Parallel()
+	// Exercise every letter and digit in odd and even positions, using public
+	// recognition. No production checksum constants are used by the oracle.
+	rec := ITFiscalCode()
+	for _, pos := range []int{0, 1, 6, 7} {
+		alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+		if pos >= 6 {
+			alphabet = "0123456789"
+		}
+		for _, c := range alphabet {
+			t.Run(fmt.Sprintf("position_%d_%c", pos+1, c), func(t *testing.T) {
+				body := []byte(itFiscalExample[:15])
+				body[pos] = byte(c)
+				code := fiscalTestCode(string(body))
+				if got := rec.Analyze(code, nil); len(got) != 1 {
+					t.Fatalf("checksum conversion failed for %q", code)
+				}
+			})
+		}
+	}
+}
+
+func TestITFiscalCodeRejectsInvalidBytes(t *testing.T) {
+	t.Parallel()
+	for i := 0; i < 16; i++ {
+		bad := []byte(itFiscalExample)
+		bad[i] = '!'
+		if validateITFiscalCode(string(bad)) {
+			t.Fatalf("non-alphanumeric byte accepted at position %d", i)
+		}
+	}
+	// Previously unsupported bytes could contribute zero and pass the checksum.
+	if validateITFiscalCode(strings.Repeat("!", 15) + "A") {
+		t.Fatal("unsupported bytes must not contribute an implicit zero")
+	}
+}
+
+func TestITFiscalCodeRegistrationAndFiltering(t *testing.T) {
+	t.Parallel()
+	for _, language := range []string{"it", "en"} {
+		t.Run(language, func(t *testing.T) {
+			registry := analyzer.NewRegistry(language)
+			LoadDefaults(registry, language)
+			engine := analyzer.NewEngine(registry, []string{language})
+			got := engine.Analyze(itFiscalExample, analyzer.Options{
+				Language: language, Entities: []string{entities.ITFiscalCode},
+			})
+			if len(got) != 1 || got[0].Text != itFiscalExample {
+				t.Fatalf("default engine missed valid CF: %+v", got)
+			}
+			if got := engine.Analyze(itFiscalExample, analyzer.Options{
+				Language: language, Entities: []string{entities.EmailAddress},
+			}); len(got) != 0 {
+				t.Fatal("entity filter was ignored")
+			}
+		})
+	}
+}
+
+func BenchmarkITFiscalCode(b *testing.B) {
+	rec := ITFiscalCode()
+	text := "Codice fiscale: " + itFiscalExample + "."
+	b.ReportAllocs()
+	b.SetBytes(int64(len(text)))
+	for b.Loop() {
+		rec.Analyze(text, nil)
+	}
+}
